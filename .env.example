BRAIN_ENDPOINT=http://192.168.2.82:8100
COURIER_ENDPOINT=http://192.168.2.81:8200

# Database / storage paths
SQLITE_LEDGER_PATH=/srv/pap/meta/downloads.db
SQLITE_DEADLETTER_PATH=/srv/pap/meta/dead_letter.db
