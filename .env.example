# Core configuration secrets
# Copy to .env and fill real values. Never commit populated .env files.

# Prefect API endpoint (self-hosted)
PREFECT_API_URL=http://192.168.2.81:4200/api
PREFECT_SERVER_API_URL=http://192.168.2.81:4200/api
PREFECT_UI_URL=http://192.168.2.81:4200
PREFECT_UI_API_URL=http://192.168.2.81:4200/api
PREFECT_DB_NAME=prefect
PREFECT_DB_USER=prefect
PREFECT_DB_PASSWORD=change-me

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ollama endpoint
OLLAMA_HOST=http://192.168.2.83:11434

# Service endpoints (used by Prefect flow)
