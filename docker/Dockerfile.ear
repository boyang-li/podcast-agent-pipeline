FROM python:3.11-slim

WORKDIR /app

COPY pyproject.toml README.md /app/
COPY src /app/src

# Install OS deps for faster-whisper
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip && pip install .[dev] && pip install faster-whisper==1.2.1

ENV PYTHONPATH=/app/src

EXPOSE 8000

ENTRYPOINT ["uvicorn", "ear.api:app", "--host", "0.0.0.0", "--port", "8000"]
